{
  "manifest_version": 3,
  "name": "AppTracker Bridge",
  "version": "0.2.0",
  "description": "Streams active tab info to the local AppTracker app via WebSocket.",
  "permissions": ["tabs", "activeTab", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "apptracker@localhost",
      "strict_min_version": "115.0"
    }
  }
}
