{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppTracker",
  "version": "0.1.0",
  "identifier": "net.mimouse.active-tracker-rust",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "AppTracker",
        "width": 1160,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AppTracker",
    "longDescription": "Active window / document / shell-cwd tracker with screenshot capture."
  }
}

